API_TOKEN=123456:telegram-bot-token
GROUP_ID=-1001234567890
CHANNEL_ID=-1001234567890

# Preferred proxy for Telegram Bot API requests.
# Use socks5h:// if DNS must also go through the proxy.
TELEGRAM_PROXY_URL=
TELEGRAM_REQUIRE_PROXY=0

# Backward-compatible aliases and generic fallbacks.
SOCKS5_PROXY_URL=
PROXY_URL=
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1
